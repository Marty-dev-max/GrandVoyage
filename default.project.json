{
  "name": "GrandVoyage",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMaxZoomDistance": 120
      },
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      },
      "StarterCharacterScripts": { "$path": "src/character" }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "ClockTime": 14.5,
        "Brightness": 3,
        "GlobalShadows": true,
        "Ambient": [0.45, 0.45, 0.52],
        "OutdoorAmbient": [0.6, 0.6, 0.68],
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 0.6
      }
    }
  }
}
